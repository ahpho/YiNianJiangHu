[
  { "id": "yinian_chengfo", "name": "一念成佛", "quote": "江湖如棋，众生如子。可谁说棋子不能跳出棋盘？", "tone": "超脱与宁静", "priority": 1, "conditions": [ { "type": "flag", "key": "completed_blood_rainforest", "present": true }, { "type": "not", "condition": { "type": "flag", "key": "used_forbidden_art", "present": true } } ], "mutuallyExclusive": ["zouhuo_rumo", "yitong_jianghu"], "scene": "xiyu_flame_temple", "finalText": "一念起，万水千山。一念灭，沧海桑田。" },
  { "id": "xueran_changkong", "name": "血染长空", "quote": "有些事，总要有人去做。哪怕代价是一条命。", "tone": "悲壮牺牲", "priority": 2, "conditions": [ { "type": "flag", "key": "face_yingsi_alone_day29", "present": true } ], "mutuallyExclusive": [], "scene": "zhongyuan_mountain", "finalText": "此处埋骨，一念之间。" },
  { "id": "zouhuo_rumo", "name": "走火入魔", "quote": "力量从来不是问题。问题是，你愿不愿意为力量付出代价。", "tone": "悲壮的堕落", "priority": 3, "conditions": [ { "type": "flag", "key": "accepted_forbidden_art_day16", "present": true }, { "type": "flag", "key": "used_forbidden_art", "present": true } ], "mutuallyExclusive": ["yinian_chengfo"], "scene": "xiyu_flame_temple", "finalText": "嵩山下了一场血雨。" },
  { "id": "yitong_jianghu", "name": "一统江湖", "quote": "江湖不需要盟主。江湖只需要一个声音。", "tone": "霸道的孤独", "priority": 4, "conditions": [ { "type": "flag", "key": "conquer_alliance_day25", "present": true } ], "mutuallyExclusive": ["yinian_chengfo", "wulin_mengzhu"], "scene": "combat_arena", "finalText": "天下武功，莫非王臣。可这天下，从来不是一个人的。" },
  { "id": "chaoting_yingquan", "name": "朝廷鹰犬", "quote": "你以为你在利用朝廷？朝廷何尝不是在利用你。", "tone": "冷峻的现实主义", "priority": 5, "conditions": [ { "type": "flag", "key": "cooperate_with_yingsi_day13", "present": true } ], "mutuallyExclusive": ["guiyin_shanlin"], "scene": "jiangnan_tavern", "finalText": "你护住了皇帝，却护不住江湖。" },
  { "id": "wulin_mengzhu", "name": "武林盟主", "quote": "盟主令牌不过一块铁，可江湖人信的是令牌后面的那个人。", "tone": "热血正道", "priority": 6, "conditions": [ { "type": "flag", "key": "run_for_alliance_day25", "present": true } ], "mutuallyExclusive": ["yitong_jianghu"], "scene": "zhongyuan_temple_indoor", "finalText": "次年春，蒙古大军南下。盟主令牌在战火中遗失。" },
  { "id": "guiyin_shanlin", "name": "归隐山林", "quote": "江湖太大，装不下两个人的心；江湖太小，躲不开一个人的影。", "tone": "温暖的遗憾", "priority": 7, "conditions": [ { "type": "flag", "key": "leave_jianghu_day29", "present": true } ], "mutuallyExclusive": ["chaoting_yingquan"], "scene": "zhongyuan_mountain", "finalText": "三十日后，江湖再无此人。" }
]
