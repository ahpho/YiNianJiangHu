      "trigger": { "timeslot": "dawn", "location": "zhongyuan", "conditions": [] },
      "scene": { "background": "zhongyuan_mountain", "description": "嵩山脚下，晨雾未散。你背着包袱站在山门前，江湖在你面前展开。", "ambient": "outdoor_birds" },
      "dialogues": [
